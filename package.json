{
  "name": "simple-hono",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"cd spa && npm run dev\"",
    "dev:restart": "lsof -ti:3000,3001 | xargs kill -9 2>/dev/null; npm run dev:all",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@clerk/backend": "^0.32.0",
    "@hono/clerk-auth": "^1.0.0",
    "@hono/node-server": "^1.13.4",
    "dotenv": "^17.4.2",
    "hono": "^4.5.10"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
